{
  "name": "pokemetrix-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "b": "pnpm -r run build",
    "build:app": "pnpm --filter @pokemetrix/app run build",
    "build:wasm": "pnpm --filter @pokemetrix/damage-calc run build",
    "pack": "pnpm --filter @pokemetrix/damage-calc run build && pnpm --filter @pokemetrix/damage-calc pack",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "fmt": "pnpm -r run fmt",
    "pretty": "pnpm -r run pretty",
    "changeset": "changeset",
    "version": "changeset version && pnpm --filter @pokemetrix/damage-calc run sync-version",
    "prepare": "husky",
    "benchmark": "pnpm --filter @pokemetrix/app run benchmark",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "ts-morph": "catalog:",
    "wrangler": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,mdx,json}": "oxfmt",
    "*.rs": "rustfmt --edition=2024"
  },
  "packageManager": "pnpm@12.3.4"
}
