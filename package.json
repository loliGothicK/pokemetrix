{
  "name": "pokemetrix-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:app": "turbo run build --filter @pokemetrix/web",
    "build:wasm": "turbo run build --filter @pokemetrix/damage-calc",
    "build:wasm:node": "turbo run build:node --filter @pokemetrix/damage-calc",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "fmt": "pnpm -r fmt",
    "pretty": "pnpm -r pretty",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "ci:publish": "pnpm publish --filter @pokemetrix/damage-calc --access=public"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "turbo": "^2.10.4"
  },
  "packageManager": "pnpm@11.11.0"
}
