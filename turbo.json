{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build:vercel": {
      "dependsOn": ["^build", "prebuild"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "src/**",
        "app/**",
        "public/**",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "outputs": [".next/**", "!.next/cache/**", "pkg/**"],
      "env": ["NODE_ENV"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "src/**",
        "app/**",
        "public/**",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "outputs": [".next/**", "!.next/cache/**", "pkg/**"],
      "env": ["NODE_ENV"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "app/**"],
      "outputs": []
    },
    "//#version": {
      "cache": false
    },
    "//#publish": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  },
  "remoteCache": {
    "signature": true
  }
}
