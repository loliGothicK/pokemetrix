{
  "name": "@pokemetrix/app",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "supabase start && pnpm db:setup:local && next dev",
    "b": "next build",
    "build": "next build",
    "build:vercel": "next build",
    "start": "next start",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ci": "vitest --run --reporter=junit --outputFile=../../test-results/vitest.xml",
    "lint": "oxlint --type-aware --type-check .",
    "lint:fix": "oxlint --fix-dangerously .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "pretty": "oxlint --fix-dangerously . && oxfmt .",
    "typecheck": "npx tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "supabase migration up",
    "db:push": "supabase db push",
    "db:setup:local": "pnpm db:migrate && pnpm db:seed",
    "db:reset:local": "supabase db reset --local && pnpm db:seed",
    "db:seed": "tsx src/lib/db/seed.ts",
    "d1:migrate": "drizzle-kit migrate --config drizzle.d1.config.ts",
    "d1:index": "tsx --env-file=../../.env scripts/index-docs.ts",
    "renovate": "ncu -u && pnpm install",
    "i18n:check": "pnpx tsx scripts/check-i18n.ts",
    "generate:quizzes": "pnpm dlx tsx scripts/generate_speed_quizzes.ts",
    "validate:domain": "pnpx tsx scripts/validate_domain.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-sql": "6.10.0",
