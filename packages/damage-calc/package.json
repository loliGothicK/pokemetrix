{
  "name": "@pokemetrix/damage-calc",
  "version": "0.1.1",
  "description": "Pokémon damage calculator — powered by Rust/WebAssembly",
  "main": "pkg/damage_calc.js",
  "types": "pkg/damage_calc.d.ts",
  "files": [
    "pkg"
  ],
  "scripts": {
    "sync-version": "node scripts/sync-version.js",
    "prebuild": "pnpm run sync-version",
    "build": "wasm-pack build --target bundler --out-dir pkg --out-name damage_calc",
    "build:node": "wasm-pack build --target nodejs --out-dir pkg-node --out-name damage_calc",
    "test": "wasm-pack test --node",
    "prepublishOnly": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/loliGothicK/pokemetrix"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "directory": "pkg",
    "provenance": true
  }
}
